<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
      Custom intent: "Hey Google, open Nestly and add feed now"
      (en-US Assistant; query patterns are the part after app invocation).
    -->
    <capability
        android:name="custom.actions.intent.ADD_FEED"
        app:queryPatterns="@array/add_feed_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lifestyle.nestly"
            android:targetClass="com.lifestyle.nestly.widget.QuickBottleLogActivity" />
    </capability>

    <!--
      BII: "Hey Google, add a feed in Nestly" / "create a bottle feed using Nestly".
      thing.name is accepted but unused — any create/add thing still quick-logs a bottle.
    -->
    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lifestyle.nestly"
            android:targetClass="com.lifestyle.nestly.widget.QuickBottleLogActivity">
            <parameter
                android:name="thing.name"
                android:key="name" />
            <parameter
                android:name="thing.description"
                android:key="description" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="add_feed"
        android:shortcutShortLabel="@string/add_feed_shortcut_short_label"
        android:shortcutLongLabel="@string/add_feed_shortcut_long_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lifestyle.nestly"
            android:targetClass="com.lifestyle.nestly.widget.QuickBottleLogActivity" />
        <capability-binding android:key="actions.intent.CREATE_THING">
            <parameter-binding
                android:key="thing.name"
                android:value="feed" />
        </capability-binding>
        <capability-binding android:key="custom.actions.intent.ADD_FEED" />
    </shortcut>
</shortcuts>
